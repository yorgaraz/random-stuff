{
  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty -e htop"
  },

  "memory": {
    "format": " {}%",
    "on-click": "kitty -e htop"
  },

  "disk": {
    "interval": 30,
    "format": "D {percentage_used}% ",
    "path": "/",
    "on-click": "kitty -e htop"
  },

  "temperature": {
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
    "interval": 1,
    "critical-threshold": 80,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input"
  },

  "custom/pcpanel": {
    "exec": "~/.local/bin/pcpanel status",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "~/.local/bin/pcpanel menu",
    "on-click-right": "~/.local/bin/pcpanel ssd toggle"
  },

  // forced quiet for notifications (bell): click toggles; "signal" lets the script refresh it at once
  "custom/quiet": {
    "exec": "~/.local/bin/quiet-mode status",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "on-click": "~/.local/bin/quiet-mode toggle"
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "disc", "temperature"]
  }
}
