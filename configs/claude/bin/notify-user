#!/usr/bin/env bash
# notify-user: the one sender for the three notification lanes (mako config: configs/mako/config).
#
#   notify-user needs <session> <text>    lane 2: a session waits for the user. One notification per session
#                                           (a repeat replaces it), one soft sound, stays until cleared
#   notify-user info <session> <text>     lane 3: FYI, small, gone after about 8 s
#   notify-user urgent <session> <text>   lane 1: hands over to need-attention (popup + red bar + over fullscreen)
#   notify-user clear <session>           the user answered that session: dismiss its notification, drop it
#   notify-user --count                   " ● N " for the tmux bar, nothing when 0
#   notify-user --list                    the waiting sessions (time, session, text)
#   notify-user --open [<client>]         tmux popup: numbered list, a number jumps to that window, q closes
#
# While quiet (a loud fullscreen window or a game: fullscreen-watch; or forced: the waybar bell, configs/mako/quiet),
# mako hides lanes 2 and 3 and the sound stays off.
# State: ${NOTIFY_USER_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/notify-user}/needs/<key>, one tab line each:
#   mako-id  tmux-target  epoch  session  text
# Session names and text come from agents and hooks: control characters are stripped, length capped, never eval'd.
# Exit: 0 = done (clear is always 0), 2 = usage.
set -u
TMUX_BIN="${NOTIFY_USER_TMUX:-/usr/bin/tmux}"   # the override is for tests
SELF=$(readlink -f "$0")
DIR="${NOTIFY_USER_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/notify-user}"
NEEDS="$DIR/needs"
SOUND="${NOTIFY_USER_SOUND:-/usr/share/sounds/freedesktop/stereo/message.oga}"
PIDFILE="${FULLSCREEN_WATCH_PIDFILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mako-fullscreen-watch.pid}"

# Strip control characters (no escape sequences reach a terminal or mako), cap the length.
clean() { printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-"$2"; }
# Pango markup is on in mako: escape the three characters that matter.
esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# State file name for a session: safe characters only; anything else gets a checksum so names stay distinct.
# Sets KEY. Forks only for an unusual name.
key_of() {
  local n=${1//[[:cntrl:]]/} h
  n=${n:0:40}
  if [[ $n =~ ^[A-Za-z0-9._-]+$ ]]; then KEY="s-$n"
  else h=$(printf '%s' "$n" | cksum); KEY="s-${n//[^A-Za-z0-9._-]/_}-${h%% *}"; fi
}

clients() { "$TMUX_BIN" list-clients -F '#{client_name} #{session_name}' 2>/dev/null | awk '$2 !~ /^rcterm-/ {print $1}'; }
refresh() { local c; while read -r c; do [[ -n $c ]] && "$TMUX_BIN" refresh-client -S -t "$c" 2>/dev/null; done < <(clients); }

# A dead fullscreen-watch cannot leave the "fullscreen" mode stuck: no live watcher -> recompute once.
ensure_watcher() {
  local pid a=() w
  if { read -r pid < "$PIDFILE"; } 2>/dev/null && [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]]; then
    mapfile -d '' a < "/proc/$pid/cmdline" 2>/dev/null
    [[ "${a[*]}" == *fullscreen-watch* ]] && return 0
  fi
  for w in "${FULLSCREEN_WATCH:-}" "$HOME/.config/mako/fullscreen-watch" "$(dirname "$SELF")/../../mako/fullscreen-watch"; do
    [[ -n $w && -x $w ]] && { "$w" --sync >/dev/null 2>&1; return 0; }
  done
}
# one definition of "quiet" (forced or fullscreen): the quiet script's is-quiet
in_quiet() {
  local q
  for q in "${NOTIFY_USER_QUIET:-}" "$HOME/.config/mako/quiet" "$(dirname "$SELF")/../../mako/quiet"; do
    [[ -n $q && -x $q ]] && { "$q" is-quiet; return; }
  done
  makoctl mode 2>/dev/null | grep -qx -e quiet -e fullscreen
}
play_sound() {
  local p
  in_quiet && return 0
  for p in pw-play paplay; do
    command -v "$p" >/dev/null && { ( setsid "$p" "$SOUND" >/dev/null 2>&1 & ); return 0; }
  done
  command -v canberra-gtk-play >/dev/null && ( setsid canberra-gtk-play -i message >/dev/null 2>&1 & )
  return 0
}
send() {  # send <app> <urgency> <replace-id|""> <summary> <body>; prints the mako id
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
  notify-send -p -a "$1" -u "$2" ${3:+-r "$3"} -- "$(esc "$4")" "$(esc "$5")" 2>/dev/null
}

# Sorted entries (oldest first), one tab line each, on stdout.
entries() { local f; for f in "$NEEDS"/*; do [[ -f $f ]] && cat -- "$f"; done 2>/dev/null | sort -t$'\t' -k3,3n; }

# Where does an entry's window live now? Stored target if it still holds that name, else search by name.
resolve_target() {  # <stored-target> <name>
  local line t n found=""
  while IFS=$'\t' read -r t n; do
    [[ $n == "$2" ]] || continue
    [[ $t == "$1" ]] && { printf '%s' "$t"; return; }
    [[ -z $found ]] && found=$t
  done < <("$TMUX_BIN" list-windows -a -F $'#{session_name}:#{window_index}\t#{window_name}' 2>/dev/null | grep -v '^rcterm-')
  printf '%s' "${found:-$1}"
}

show() {  # popup body
  local client=${1:-} last="" sum key i line id tgt at who why tf
  local -a tg
  while :; do
    sum=$(entries | cksum)
    if [[ $sum != "$last" ]]; then
      last=$sum; tg=(); i=0
      clear
      printf '\n  \033[1;30;43m  CLAUDE IS WAITING FOR YOU  \033[0m\n\n'
      while IFS=$'\t' read -r id tgt at who why; do
        [[ -n $who ]] || continue
        i=$((i + 1)); (( i > 9 )) && continue
        tg[i]="$tgt|$who"
        printf '  \033[1;33m%d\033[0m  \033[1m%s\033[0m  \033[2m%s\033[0m\n      %s\n\n' "$i" "$who" "$(date -d "@$at" +%H:%M 2>/dev/null)" "$why"
      done < <(entries)
      (( i == 0 )) && printf '  (nobody is waiting)\n\n'
      (( i > 9 )) && printf '  ... and %d more\n\n' $((i - 9))
      printf '  \033[2m1-9 = go to that window      q = close\033[0m\n'
    fi
    if IFS= read -rsn1 -t 2 key; then
      [[ $key == q ]] && return 0
      if [[ $key =~ ^[1-9]$ && -n ${tg[key]:-} ]]; then
        tf=${tg[key]%%|*}; who=${tg[key]#*|}; [[ $tf == - ]] && tf=""
        tf=$(resolve_target "$tf" "$who")
        if [[ -n $tf ]]; then
          "$TMUX_BIN" select-window -t "$tf" 2>/dev/null
          "$TMUX_BIN" switch-client ${client:+-c "$client"} -t "$tf" 2>/dev/null
        fi
        return 0
      fi
    fi
  done
}

open_popup() {  # [<client>]: that client only, else every attached one
  local c cmd
  while read -r c; do
    [[ -n $c ]] || continue
    [[ -n ${1:-} && $c != "$1" ]] && continue
    printf -v cmd '%q %q %q' "$SELF" --show "$c"
    setsid nohup "$TMUX_BIN" display-popup -c "$c" -E -w 70% -h 60% -b rounded -S 'fg=#f9e2af' \
      -T ' Claude is waiting ' "$cmd" >/dev/null 2>&1 &
  done < <(clients)
}

case "${1:-}" in
  --show) show "${2:-}"; exit 0 ;;
  --count)
    n=0
    for f in "$NEEDS"/*; do [[ -f $f ]] && n=$((n + 1)); done
    (( n > 0 )) && printf ' ● %d ' "$n"
    exit 0 ;;
  --list)
    while IFS=$'\t' read -r id tgt at who why; do
      printf '%s\t%s\t%s\n' "$(date -d "@$at" '+%d-%b %H:%M' 2>/dev/null)" "$who" "$why"
    done < <(entries)
    exit 0 ;;
  --open) open_popup "${2:-}"; exit 0 ;;
  clear)
    [[ $# -ge 2 ]] || { echo "usage: notify-user clear <session>" >&2; exit 2; }
    key_of "$2"
    [[ -f $NEEDS/$KEY ]] || exit 0          # nothing waiting for this session: no forks, no output
    IFS=$'\t' read -r id _ < "$NEEDS/$KEY"
    rm -f -- "$NEEDS/$KEY"
    [[ ${id:-} =~ ^[0-9]+$ ]] && makoctl dismiss -h -n "$id" >/dev/null 2>&1
    refresh
    exit 0 ;;
  needs|info|urgent)
    [[ $# -ge 3 ]] || { echo "usage: notify-user needs|info|urgent <session> <text>" >&2; exit 2; } ;;
  ""|-h|--help) sed -n '2,12p' "$SELF"; exit 2 ;;
  *) echo "notify-user: unknown command $1" >&2; exit 2 ;;
esac

lane=$1
who=$(clean "$2" 40); [[ -n $who ]] || who=session
why=$(clean "$3" 240)

if [[ $lane == urgent ]]; then
  u=$(command -v need-attention || echo "$(dirname "$SELF")/need-attention")
  exec "$u" "$who" "$why"
fi

ensure_watcher
if [[ $lane == info ]]; then
  send claude-info low "" "$who" "$why" >/dev/null
  exit 0
fi

# lane 2: needs
mkdir -p "$NEEDS" && chmod 700 "$DIR" "$NEEDS"
key_of "$who"
old_id="" old_why=""
[[ -f $NEEDS/$KEY ]] && IFS=$'\t' read -r old_id _ _ _ old_why < "$NEEDS/$KEY"
[[ ${old_id:-} =~ ^[0-9]+$ ]] || old_id=""
new_id=$(send claude-needs normal "$old_id" "$who needs you" "$why")
[[ $new_id =~ ^[0-9]+$ ]] || new_id=0
tmp=$(mktemp "$NEEDS/.tmp.XXXXXX") || exit 0
tgt=$(clean "${NOTIFY_USER_TARGET:-}" 80); tgt=${tgt:--}   # "-" = unknown (tabs are IFS whitespace: an empty field would collapse)
printf '%s\t%s\t%s\t%s\t%s\n' "$new_id" "$tgt" "$(date +%s)" "$who" "$why" > "$tmp"
mv -f -- "$tmp" "$NEEDS/$KEY"
# the same text again (an idle reminder) replaces the popup silently
[[ $why == "${old_why:-}" && -n $old_id ]] || play_sound
refresh
exit 0
