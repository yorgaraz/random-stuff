#!/usr/bin/env bash
# need-attention: put an URGENT popup on every attached tmux client, plus a Hyprland on-screen notice.
#
#   need-attention <session-name> <one-line why>     raise it (returns at once)
#   need-attention --list                            what is still unseen
#   need-attention --count                           " ! N " for the tmux status bar, nothing when 0
#   need-attention --open                            reopen the popup on the attached clients
#   need-attention --show                            (internal) the popup body
#
# Super-critical only: a prod outage or data at risk, a live operation stuck on a human decision, a window
# about to close. Never routine updates. Every call is logged in urgent/log.
# Exit: 0 = shown on at least one tmux client or as a Hyprland notice; 1 = nowhere to show it; 2 = usage.
set -u
TMUX_BIN=/usr/bin/tmux
SELF=$(readlink -f "$0")
DIR="${NEED_ATTENTION_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/need-attention}"
PENDING="$DIR/pending"
LOG="$DIR/log"
# Machine-specific: tmux sessions whose clients never get the popup (regex on the session name).
# Here: the rcterm-* twins of an in-game terminal. Set NEED_ATTENTION_SKIP to your own, or leave it empty.
SKIP="${NEED_ATTENTION_SKIP-^rcterm-}"

# The text comes from an agent: strip control characters (no escape sequences reach the terminal), cap it.
clean() { printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-"$2"; }

show() {
  local key sum last=""
  SECONDS=0
  while :; do
    sum=$(cksum "$PENDING" 2>/dev/null)
    if [[ "$sum" != "$last" ]]; then
      last=$sum
      clear
      printf '\n  \033[1;37;41m  ATTENTION NEEDED NOW  \033[0m\n\n'
      if [[ -s "$PENDING" ]]; then
        while IFS=$'\t' read -r at who why; do
          printf '  \033[1;33m%s\033[0m  \033[1m%s\033[0m\n      %s\n\n' "$at" "$who" "$why"
        done < "$PENDING"
      else
        printf '  (nothing pending)\n\n'
      fi
      printf '  \033[2ms = seen, clear the list      q = close, keep the list      (keys ignored for the first 2 s)\033[0m\n'
    fi
    # redraw when another session adds a line while the popup is open
    if IFS= read -rsn1 -t 2 key; then
      (( SECONDS < 2 )) && continue
      [[ "$key" == q ]] && return 0
      if [[ "$key" == s ]]; then
        [[ -s "$PENDING" ]] && sed "s/^/seen $(date '+%F %T')\t/" "$PENDING" >> "$LOG"
        : > "$PENDING"
        refresh
        return 0
      fi
    fi
  done
}

# Attached clients, without the sessions matched by SKIP.
clients() {
  "$TMUX_BIN" list-clients -F '#{client_name} #{session_name}' 2>/dev/null |
    awk -v skip="$SKIP" 'skip == "" || $2 !~ skip {print $1}'
}
refresh() { local c; while read -r c; do "$TMUX_BIN" refresh-client -S -t "$c" 2>/dev/null; done < <(clients); }
popup() {
  local c n=0
  while read -r c; do
    [[ -n "$c" ]] || continue
    setsid nohup "$TMUX_BIN" display-popup -c "$c" -E -w 80% -h 50% -b heavy -S 'fg=red' \
      -T ' ATTENTION NEEDED NOW ' "$SELF --show" >/dev/null 2>&1 &
    n=$((n + 1))
  done < <(clients)
  echo "$n"
}

case "${1:-}" in
  --show) show; exit 0 ;;
  --count) n=$(grep -c . "$PENDING" 2>/dev/null); [[ "${n:-0}" -gt 0 ]] && printf ' ! %s ' "$n"; exit 0 ;;
  --open) popup >/dev/null; exit 0 ;;
  --list) [[ -s "$PENDING" ]] && cat "$PENDING"; exit 0 ;;
  ""|-h|--help) sed -n '2,13p' "$SELF"; exit 2 ;;
esac
[[ $# -ge 2 ]] || { echo "usage: need-attention <session-name> <one-line why>" >&2; exit 2; }

who=$(clean "$1" 40)
why=$(clean "$2" 240)
mkdir -p "$DIR" && chmod 700 "$DIR"
at=$(date '+%d-%b %H:%M')
printf '%s\t%s\t%s\n' "$at" "$who" "$why" >> "$PENDING"
printf 'raised %s\t%s\t%s\n' "$(date '+%F %T')" "$who" "$why" >> "$LOG"

# One popup per attached client. A client that already shows a popup refuses a second one; the open
# need-attention popup redraws from the pending file, so the new line still appears there.
shown=$(popup)
refresh

# Desktop notification (stays until dismissed, keeps history) for when the terminal is hidden.
if command -v notify-send >/dev/null; then
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
    notify-send -u critical -a need-attention "ATTENTION NEEDED NOW: $who" "$why" >/dev/null 2>&1 && shown=$((shown + 1))
fi

# Hyprland on-screen notice as well (30 s, no history). Needs no notification daemon.
sig="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "/run/user/$(id -u)/hypr" 2>/dev/null | head -1)}"
if [[ -n "$sig" ]] && command -v hyprctl >/dev/null; then
  HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl notify 0 30000 "rgb(ff5555)" \
    "fontsize:22 ATTENTION NEEDED NOW: $who: $why" >/dev/null 2>&1 && shown=$((shown + 1))
fi

if (( shown == 0 )); then
  echo "need-attention: no tmux client and no Hyprland session; it stays in $PENDING" >&2
  exit 1
fi
echo "need-attention: raised on $shown surface(s); pending list: $PENDING"
