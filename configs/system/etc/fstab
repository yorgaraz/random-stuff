# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=238f3ad8-ce9f-4c58-98a7-60cd3445dfd5 /              btrfs   subvol=/@,defaults,discard=async,ssd 0 0
UUID=238f3ad8-ce9f-4c58-98a7-60cd3445dfd5 /home          btrfs   subvol=/@home,defaults,discard=async,ssd 0 0
UUID=238f3ad8-ce9f-4c58-98a7-60cd3445dfd5 /var/cache     btrfs   subvol=/@cache,defaults,discard=async,ssd 0 0
UUID=238f3ad8-ce9f-4c58-98a7-60cd3445dfd5 /var/log       btrfs   subvol=/@log,defaults,discard=async,ssd 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0
